# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud
# "Advanced settings -> Secrets". Never commit the real secrets.toml.
#
# For a public repository these defaults are enough and this file may be
# left untouched. Override them only when using another release or a private
# repository.

DATA_RELEASE_REPO = "MoisesHsilva1/projeto-integrador-dash"
DATA_RELEASE_TAG = "data-v1"
DATA_RELEASE_ASSET = "transactions.parquet"

# Full URL override (takes precedence over the three settings above):
# DATA_DOWNLOAD_URL = "https://github.com/OWNER/REPO/releases/download/TAG/transactions.parquet"

# Only needed when the release belongs to a private repository:
# DATA_DOWNLOAD_TOKEN = "ghp_..."
